<% if matches.blank? %>
  <p class="text-sm text-gray-400"><%= empty %></p>
<% else %>
  <ul class="space-y-2 max-h-72 overflow-y-auto">
    <% matches.first(20).each do |match| %>
      <% user_card = match.user_card %>
      <% next unless user_card&.card_version&.card %>
      <li class="flex items-center gap-3">
        <%= image_tag user_card.card_version.img_uri,
              class: "h-10 w-8 rounded object-cover flex-shrink-0 bg-gray-100",
              loading: "lazy", alt: "" if user_card.card_version.img_uri.present? %>
        <div class="min-w-0">
          <p class="text-sm font-medium text-gray-900 truncate">
            <%= user_card.card_version.card.name_fr.presence || user_card.card_version.card.name_en %>
          </p>
          <p class="text-xs text-gray-500"><%= condition_label(user_card.condition) %><%= " · Foil" if user_card.foil %></p>
        </div>
      </li>
    <% end %>
    <% if matches.size > 20 %>
      <li class="text-xs text-gray-400 pt-1">+ <%= matches.size - 20 %> autre(s)…</li>
    <% end %>
  </ul>
<% end %>
