<%# app/views/matches/index.html.erb %>
<div class="mx-auto max-w-7xl px-4 sm:px-6 py-6">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Vos matchs</h1>
    <p class="text-sm ap-muted mt-0.5">Les joueurs avec qui un échange est possible.</p>
  </div>

  <%# Stats %>
  <div class="mt-5 ap-card overflow-hidden flex divide-x ap-divide w-full sm:w-fit">
    <% [
         [@stats[:matches], "Correspondances"],
         [@stats[:partners], "Partenaires"],
         [@stats[:active_trades], "En cours"]
       ].each do |num, label| %>
      <div class="px-6 py-3.5 flex-1">
        <div class="ap-num text-xl font-bold"><%= num %></div>
        <div class="ap-label !text-[10px] mt-0.5"><%= label %></div>
      </div>
    <% end %>
  </div>

  <% if @partner_pairs.empty? %>
    <div class="ap-card p-10 text-center mt-5">
      <h2 class="text-base font-bold mb-1">Aucune correspondance pour l'instant</h2>
      <p class="ap-muted text-sm mb-5">Ajoutez des cartes à votre collection et à votre liste de recherche.</p>
      <%= link_to "Importer ma collection", import_user_user_cards_path(current_user), class: "ap-btn-accent" %>
    </div>
  <% end %>

  <div class="space-y-4 mt-5">
    <% @partner_pairs.each do |partner_id, lists| %>
      <% partner = @partner_users[partner_id] %>
      <% next unless partner %>
      <% distance = (current_user.distance_to(partner) if current_user.latitude.present? && partner.latitude.present?) %>

      <div class="ap-card overflow-hidden">
        <div class="px-5 py-3.5 border-b ap-divide flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold"><%= partner.username %></h2>
            <div class="mt-0.5 flex items-center gap-3 text-xs ap-muted">
              <% if distance %><span>📍 <span class="ap-num"><%= distance.round %></span> km</span><% end %>
              <% if partner.rating_count.positive? %>
                <span>★ <span class="ap-num"><%= partner.average_rating %></span> (<%= partner.rating_count %>)</span>
              <% else %>
                <span class="ap-faint">Pas encore noté</span>
              <% end %>
            </div>
          </div>
          <%= link_to "Proposer un échange", new_proposition_trade_path(partner, partner_id: partner.id), class: "ap-btn-accent text-sm", data: { turbo: false } %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 md:divide-x ap-divide">
          <div class="p-4 border-b md:border-b-0 ap-divide">
            <h3 class="ap-label mb-3 flex items-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full" style="background:#9a3b2c;"></span>
              Vous donnez <span class="ap-faint normal-case">(<%= lists[:give].size %>)</span>
            </h3>
            <%= render "matches/card_chips", matches: lists[:give], empty: "Aucune carte qu'il/elle recherche." %>
          </div>
          <div class="p-4">
            <h3 class="ap-label mb-3 flex items-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full" style="background: var(--ap-accent);"></span>
              Vous recevez <span class="ap-faint normal-case">(<%= lists[:receive].size %>)</span>
            </h3>
            <%= render "matches/card_chips", matches: lists[:receive], empty: "Rien que vous recherchez chez lui/elle." %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @pagy && @pagy.pages > 1 %>
    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
</div>
