<div class="divide-y-2 divide-cm-border/20">
  <% if trades.any? %>
    <% trades.each do |trade| %>
      <div class="py-3 first:pt-0 last:pb-0">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <%= card_image_tag(trade.user_cards.first&.card_version, class: "h-10 w-8 object-cover border border-cm-ink flex-shrink-0") %>
            <div class="min-w-0">
              <h4 class="text-sm font-bold truncate">Échange avec <%= trade.partner_name_for(current_user) %></h4>
              <p class="text-xs text-cm-text-muted flex items-center gap-2">
                <%= pluralize(trade.user_cards.count, 'carte') %>
                <span class="cm-tag"><%= trade_status_text(trade.status) %></span>
              </p>
            </div>
          </div>
          <%= link_to trade_path(trade), class: "shrink-0 text-cm-accent hover:underline font-bold text-sm", data: { turbo: false } do %>→<% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="py-4 text-center text-sm text-cm-text-muted">Aucun échange récent</p>
  <% end %>
</div>
