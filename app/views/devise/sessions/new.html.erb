<div class="flex flex-col justify-center py-12">
  <div class="w-full max-w-md mx-auto px-4 sm:px-6">
    <div class="mb-6">
      <div class="ap-label">Connexion</div>
      <h2 class="text-2xl font-bold tracking-tight mt-1"><%= t('devise.sessions.new.welcome_back') %></h2>
      <p class="mt-1 text-sm ap-muted"><%= t('devise.sessions.new.sign_in_to_continue') %></p>
    </div>

    <div class="ap-card p-6 sm:p-7">
      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="space-y-5">
          <%= f.input :email, required: false, autofocus: true, hint: false,
                      input_html: { class: "ap-search", autocomplete: "email", placeholder: "vous@email.com" },
                      wrapper_html: { class: "block" },
                      label_html: { class: "block text-sm font-semibold mb-1.5" } %>
          <%= f.input :password, required: false, hint: false,
                      input_html: { class: "ap-search", autocomplete: "current-password", placeholder: "••••••••" },
                      wrapper_html: { class: "block" },
                      label_html: { class: "block text-sm font-semibold mb-1.5" } %>

          <div class="flex items-center justify-between">
            <% if devise_mapping.rememberable? %>
              <%= f.input :remember_me, as: :boolean, hint: false,
                          input_html: { class: "h-4 w-4 rounded" },
                          wrapper_html: { class: "flex items-center" },
                          label_html: { class: "ml-2 text-sm ap-muted" } %>
            <% end %>
            <%- if devise_mapping.recoverable? %>
              <%= link_to t('devise.shared.links.forgot_password'), new_password_path(resource_name), class: "text-sm font-semibold ap-link" %>
            <% end %>
          </div>

          <%= f.button :submit, t('devise.sessions.new.sign_in'), class: "ap-btn-accent w-full" %>
        </div>
      <% end %>

      <div class="mt-6 pt-5 border-t ap-divide text-center text-sm ap-muted">
        <%= t('devise.sessions.new.or_continue_with') %>
        <%- if devise_mapping.registerable? %>
          <%= link_to t('devise.shared.links.sign_up'), new_registration_path(resource_name), class: "ap-link font-semibold ml-1" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
