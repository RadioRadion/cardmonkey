<div class="flex flex-col justify-center py-12">
  <div class="w-full max-w-md mx-auto px-4 sm:px-6">
    <div class="mb-6">
      <div class="ap-label">Inscription</div>
      <h2 class="text-2xl font-bold tracking-tight mt-1"><%= t('devise.registrations.new.title') %></h2>
      <p class="mt-1 text-sm ap-muted"><%= t('devise.registrations.new.subtitle') %></p>
    </div>

    <div class="ap-card p-6 sm:p-7">
      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= f.error_notification class: "mb-5 p-3 rounded-md bg-red-50 text-red-600 text-sm" %>

        <div class="space-y-5">
          <%= f.input :email, required: true, autofocus: true,
                      input_html: { class: "ap-search", autocomplete: "email", placeholder: "vous@email.com" },
                      wrapper_html: { class: "block" }, label_html: { class: "block text-sm font-semibold mb-1.5" } %>
          <%= f.input :password, required: true,
                      hint: t('simple_form.hints.user.password', minimum_password_length: @minimum_password_length),
                      input_html: { class: "ap-search", autocomplete: "new-password", placeholder: "••••••••" },
                      wrapper_html: { class: "block" }, label_html: { class: "block text-sm font-semibold mb-1.5" },
                      hint_html: { class: "mt-1.5 text-xs ap-faint" } %>
          <%= f.input :password_confirmation, required: true,
                      input_html: { class: "ap-search", autocomplete: "new-password", placeholder: "••••••••" },
                      wrapper_html: { class: "block" }, label_html: { class: "block text-sm font-semibold mb-1.5" } %>
          <%= f.input :address, required: true, label: "Ville ou adresse",
                      hint: "Pour vous proposer des échanges près de chez vous. Une ville suffit.",
                      input_html: { class: "ap-search", autocomplete: "address-level2", placeholder: "Lyon, France" },
                      wrapper_html: { class: "block" }, label_html: { class: "block text-sm font-semibold mb-1.5" },
                      hint_html: { class: "mt-1.5 text-xs ap-faint" } %>

          <%= f.button :submit, t('devise.registrations.new.sign_up'), class: "ap-btn-accent w-full" %>
        </div>
      <% end %>

      <div class="mt-6 pt-5 border-t ap-divide text-center text-sm ap-muted">
        <%= t('devise.registrations.new.already_have_account') %>
        <%= link_to t('devise.shared.links.sign_in'), new_session_path(resource_name), class: "ap-link font-semibold ml-1" %>
      </div>
    </div>
  </div>
</div>
