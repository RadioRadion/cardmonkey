<%# Checklist d'accueil — affichée tant que tout n'est pas fait (style app). %>
<% steps = [
     { done: @onboarding[:address],  label: "Renseignez votre ville", hint: "Pour trouver des échanges près de chez vous",
       path: edit_user_path(current_user), cta: "Compléter" },
     { done: @onboarding[:cards],    label: "Importez votre collection", hint: "Liste à coller ou fichier CSV (ManaBox, Moxfield…)",
       path: import_user_user_cards_path(current_user), cta: "Importer" },
     { done: @onboarding[:wishlist], label: "Ajoutez vos cartes recherchées", hint: "Pour que l'algorithme trouve vos échanges",
       path: new_user_user_wanted_card_path(current_user), cta: "Ajouter" }
   ] %>
<% done_count = steps.count { |s| s[:done] } %>

<% unless done_count == steps.size %>
  <section class="ap-card overflow-hidden mt-5">
    <div class="px-4 py-3 border-b ap-divide flex items-center justify-between">
      <h2 class="ap-label">Bien démarrer</h2>
      <span class="ap-chip ap-num"><%= done_count %>/<%= steps.size %></span>
    </div>
    <div class="px-4 pt-3">
      <div class="h-1.5 rounded-full" style="background: var(--ap-line);">
        <div class="h-full rounded-full" style="width: <%= (done_count.to_f / steps.size * 100).round %>%; background: var(--ap-accent);"></div>
      </div>
    </div>
    <ul class="divide-y ap-divide mt-1">
      <% steps.each_with_index do |step, i| %>
        <li class="flex items-center justify-between gap-4 px-4 py-3">
          <div class="flex items-center gap-3 min-w-0">
            <% if step[:done] %>
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-white text-xs shrink-0" style="background: var(--ap-accent);">✓</span>
            <% else %>
              <span class="ap-num inline-flex items-center justify-center w-7 h-7 rounded-full text-sm font-semibold shrink-0" style="background: var(--ap-bg); color: var(--ap-muted);"><%= i + 1 %></span>
            <% end %>
            <div class="min-w-0">
              <p class="text-sm font-semibold <%= 'ap-faint line-through' if step[:done] %>"><%= step[:label] %></p>
              <% unless step[:done] %><p class="text-xs ap-muted truncate"><%= step[:hint] %></p><% end %>
            </div>
          </div>
          <% unless step[:done] %>
            <%= link_to step[:cta], step[:path], class: "ap-chip ap-chip-accent whitespace-nowrap" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
