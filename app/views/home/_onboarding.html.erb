<%# Guided first steps — shown until everything is done. %>
<% steps = [
     { key: :address,  done: @onboarding[:address],  label: "Renseignez votre ville",
       hint: "Pour trouver des échanges près de chez vous",
       path: edit_user_path(current_user), cta: "Compléter" },
     { key: :cards,    done: @onboarding[:cards],    label: "Importez votre collection",
       hint: "Liste à coller ou fichier CSV (ManaBox, Moxfield…)",
       path: import_user_user_cards_path(current_user), cta: "Importer" },
     { key: :wishlist, done: @onboarding[:wishlist], label: "Ajoutez vos cartes recherchées",
       hint: "Pour que l'algorithme trouve vos échanges",
       path: new_user_user_wanted_card_path(current_user), cta: "Ajouter" }
   ] %>
<% done_count = steps.count { |s| s[:done] } %>

<% unless done_count == steps.size %>
  <div class="cm-card-flat p-6 mb-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="cm-display text-2xl">Bien démarrer</h2>
      <span class="cm-tag"><%= done_count %>/<%= steps.size %></span>
    </div>

    <div class="w-full bg-cm-surface-2 border-2 border-cm-ink h-3 mb-5">
      <div class="bg-cm-accent h-full transition-all" style="width: <%= (done_count.to_f / steps.size * 100).round %>%"></div>
    </div>

    <ul class="space-y-3">
      <% steps.each_with_index do |step, i| %>
        <li class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-3 min-w-0">
            <% if step[:done] %>
              <span class="flex-shrink-0 h-8 w-8 bg-cm-success text-white flex items-center justify-center border-2 border-cm-ink">
                <i class="fas fa-check text-sm"></i>
              </span>
            <% else %>
              <span class="flex-shrink-0 h-8 w-8 bg-cm-accent text-white cm-display flex items-center justify-center border-2 border-cm-ink"><%= i + 1 %></span>
            <% end %>
            <div class="min-w-0">
              <p class="text-sm font-bold <%= step[:done] ? 'text-cm-text-subtle line-through' : 'text-cm-ink' %>"><%= step[:label] %></p>
              <% unless step[:done] %><p class="text-xs text-cm-text-muted truncate"><%= step[:hint] %></p><% end %>
            </div>
          </div>
          <% unless step[:done] %>
            <%= link_to step[:cta], step[:path], class: "flex-shrink-0 text-sm font-bold uppercase tracking-wide text-cm-accent hover:underline" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
