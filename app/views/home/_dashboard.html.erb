<div class="cm-theme min-h-screen">
  <div class="container mx-auto px-4 py-8">
    <%# ───────────── Hero + stats ───────────── %>
    <div class="cm-card-flat p-6 sm:p-8 mb-8">
      <div class="flex items-start justify-between gap-6">
        <div class="flex-grow">
          <span class="cm-kicker text-cm-accent">Tableau de bord</span>
          <h1 class="cm-display text-4xl sm:text-5xl mt-2">
            Salut, <span class="text-cm-accent"><%= current_user.username %></span>
          </h1>
          <p class="mt-3 text-cm-text-muted">Gérez vos cartes et trouvez des échanges.</p>

          <div class="mt-6 flex flex-wrap border-2 border-cm-ink divide-x-2 divide-cm-ink w-fit">
            <% [
                 [current_user.user_cards.sum(:quantity), "En collection"],
                 [current_user.user_wanted_cards.count, "Recherchées"],
                 [current_user.trades.where(status: :done).count, "Échanges faits"]
               ].each do |num, label| %>
              <div class="px-5 py-3">
                <div class="cm-display text-3xl"><%= num %></div>
                <div class="text-[11px] font-bold uppercase tracking-widest text-cm-text-muted"><%= label %></div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="hidden sm:block flex-shrink-0">
          <%= render "users/avatar", user: current_user, size: "large" %>
        </div>
      </div>
    </div>

    <%= render "home/onboarding" if @onboarding %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <%# ───────────── Left column ───────────── %>
      <div class="lg:col-span-1 space-y-8">
        <%# Opportunités %>
        <div class="cm-card-flat p-6">
          <h2 class="cm-display text-2xl mb-5">Opportunités</h2>
          <% if !current_user.user_wanted_cards.any? %>
            <div class="text-center py-6">
              <p class="text-sm text-cm-text-muted mb-4">Ajoutez des cartes recherchées pour voir les opportunités d'échange.</p>
              <%= link_to "Ajouter des recherches", new_user_user_wanted_card_path(current_user), class: "cm-btn-ink text-xs", data: { turbo: false } %>
            </div>
          <% elsif @potential_matches.empty? %>
            <div class="text-center py-6">
              <p class="text-sm text-cm-text-muted mb-4">Pas de match pour l'instant. Enrichissez votre collection pour augmenter vos chances.</p>
              <%= link_to "Ajouter des cartes", new_user_user_card_path(current_user), class: "cm-btn-ink text-xs", data: { turbo: false } %>
            </div>
          <% else %>
            <div class="space-y-3">
              <% @potential_matches.first(3).each do |match| %>
                <% partner = @match_users_by_id[match.user_id == current_user.id ? match.user_id_target : match.user_id] %>
                <div class="flex items-center justify-between gap-3 border-b border-cm-border/30 pb-3 last:border-0">
                  <div class="flex items-center gap-3 min-w-0">
                    <% if match.user_card.card_version.img_uri %>
                      <%= image_tag match.user_card.card_version.img_uri, class: "h-10 w-8 object-cover border border-cm-ink", loading: "lazy" %>
                    <% end %>
                    <div class="min-w-0">
                      <p class="text-sm font-bold truncate"><%= match.user_card.card_version.card.name_fr %></p>
                      <p class="text-xs text-cm-text-muted"><%= partner&.username %></p>
                    </div>
                  </div>
                  <% if partner %>
                    <%= link_to "Échanger", new_proposition_trade_path(partner, partner_id: partner.id), class: "text-xs font-bold uppercase tracking-wide text-cm-accent hover:underline", data: { turbo: false } %>
                  <% end %>
                </div>
              <% end %>
              <%= link_to "Voir tout →", matches_path, class: "block text-center text-xs font-bold uppercase tracking-wide text-cm-accent hover:underline mt-3" %>
            </div>
          <% end %>
        </div>

        <%# Actions rapides %>
        <div class="cm-card-flat p-6">
          <h2 class="cm-display text-2xl mb-5">Actions</h2>
          <div class="space-y-3">
            <%= link_to import_user_user_cards_path(current_user), class: "cm-btn-primary w-full justify-between" do %>
              <span>Importer (liste / CSV)</span><i class="fas fa-file-import"></i>
            <% end %>
            <%= link_to new_user_user_card_path(current_user), class: "cm-btn-ink w-full justify-between" do %>
              <span>Ajouter une carte</span><i class="fas fa-plus"></i>
            <% end %>
            <%= link_to user_user_wanted_cards_path(current_user), class: "cm-btn-ghost w-full justify-between" do %>
              <span>Liste de souhaits</span><i class="fas fa-star"></i>
            <% end %>
          </div>
        </div>

        <%# Notifications %>
        <div class="cm-card-flat p-6">
          <h2 class="cm-display text-2xl mb-4">Notifications</h2>
          <%= render partial: "notifications/list", locals: { notifications: @notifications || [] } %>
        </div>
      </div>

      <%# ───────────── Main column ───────────── %>
      <div class="lg:col-span-2 space-y-8">
        <%# Collection highlights %>
        <div class="cm-card-flat p-6">
          <div class="flex items-center justify-between mb-5">
            <h2 class="cm-display text-2xl">Votre collection</h2>
            <%= link_to "Voir tout →", user_user_cards_path(current_user), class: "text-xs font-bold uppercase tracking-wide text-cm-accent hover:underline" %>
          </div>

          <% if @user_cards.any? %>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <% @user_cards.first(4).each do |user_card| %>
                <div class="group relative border-2 border-cm-ink">
                  <div class="aspect-[63/88] overflow-hidden bg-cm-surface-2">
                    <% if user_card.card_version.img_uri.present? %>
                      <img src="<%= user_card.card_version.img_uri %>" alt="<%= user_card.card_version.card.name %>"
                           class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-105" />
                    <% end %>
                  </div>
                  <div class="absolute inset-x-0 bottom-0 bg-cm-ink/85 text-cm-bg px-2 py-1 flex items-center justify-between text-xs">
                    <span class="font-bold"><%= user_card.quantity %>×</span>
                    <span><%= number_to_currency(user_card.card_version.eur_price, unit: "€") %></span>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8 border-2 border-dashed border-cm-border">
              <p class="text-cm-text-muted mb-4">Aucune carte pour l'instant.</p>
              <%= link_to "Importer ma collection", import_user_user_cards_path(current_user), class: "cm-btn-primary text-xs" %>
            </div>
          <% end %>
        </div>

        <%# Recent trades %>
        <div class="cm-card-flat p-6">
          <div class="flex items-center justify-between mb-5">
            <h2 class="cm-display text-2xl">Échanges récents</h2>
            <%= link_to "Voir tout →", trades_path, class: "text-xs font-bold uppercase tracking-wide text-cm-accent hover:underline" %>
          </div>
          <%= render partial: "trades/recent_list", locals: { trades: @recent_trades || [] } %>
        </div>

        <%# Wanted cards %>
        <div class="cm-card-flat p-6">
          <div class="flex items-center justify-between mb-5">
            <h2 class="cm-display text-2xl">Recherchées</h2>
            <%= link_to "Gérer →", user_user_wanted_cards_path(current_user), class: "text-xs font-bold uppercase tracking-wide text-cm-accent hover:underline" %>
          </div>

          <% if @user_wanted_cards&.any? %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <% @user_wanted_cards.first(4).each do |wanted_card| %>
                <div class="flex items-center gap-3 p-3 border-2 border-cm-ink">
                  <div class="w-10 h-14 overflow-hidden flex-shrink-0 bg-cm-surface-2 border border-cm-ink">
                    <% img = wanted_card.card_version&.img_uri || wanted_card.card.card_versions.first&.img_uri %>
                    <% if img.present? %>
                      <img src="<%= img %>" alt="<%= wanted_card.card.name %>" class="w-full h-full object-cover" />
                    <% end %>
                  </div>
                  <div class="min-w-0">
                    <h3 class="font-bold truncate"><%= wanted_card.card.name %></h3>
                    <div class="flex flex-wrap items-center gap-2 text-xs text-cm-text-muted">
                      <% if wanted_card.min_condition %><span>Min: <%= wanted_card.min_condition.humanize %></span><% end %>
                      <% if wanted_card.foil %><span class="text-cm-accent font-bold">Foil</span><% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8 border-2 border-dashed border-cm-border">
              <p class="text-cm-text-muted mb-4">Liste de souhaits vide.</p>
              <%= link_to "Ajouter des recherches", new_user_user_wanted_card_path(current_user), class: "cm-btn-ink text-xs" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
