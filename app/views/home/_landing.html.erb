<div class="cm-theme overflow-hidden">
  <%# ───────────── Marquee ticker ───────────── %>
  <div class="bg-cm-ink text-cm-bg py-2 border-b-2 border-cm-ink overflow-hidden">
    <div class="flex whitespace-nowrap animate-marquee">
      <% 2.times do %>
        <div class="flex items-center gap-6 pr-6 text-sm font-bold uppercase tracking-[0.2em]">
          <span>Échangez</span><span class="text-cm-accent">✦</span>
          <span>Collectionnez</span><span class="text-cm-accent">✦</span>
          <span>Près de chez vous</span><span class="text-cm-accent">✦</span>
          <span>Zéro frais</span><span class="text-cm-accent">✦</span>
          <span>Magic: The Gathering</span><span class="text-cm-accent">✦</span>
        </div>
      <% end %>
    </div>
  </div>

  <%# ───────────── Hero ───────────── %>
  <section class="mx-auto max-w-7xl px-6 pt-14 pb-20">
    <div class="grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <span class="cm-tag-pop">MARKETPLACE D'ÉCHANGE MTG</span>

        <h1 class="cm-display mt-5 text-6xl sm:text-7xl xl:text-8xl">
          Échangez<br>
          vos cartes<br>
          <span class="text-cm-accent">Magic.</span>
        </h1>

        <p class="mt-6 max-w-md text-lg text-cm-text-muted">
          Importez votre collection en quelques secondes. On trouve les joueurs près de chez vous
          qui veulent vos cartes — et l'inverse.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <%= link_to "Commencer — c'est gratuit", new_user_registration_path, class: "cm-btn-primary text-base" %>
          <%= link_to "Se connecter", new_user_session_path, class: "cm-btn-ghost text-base" %>
        </div>

        <%# Stats — big bold, divided %>
        <div class="mt-12 flex flex-wrap items-stretch border-2 border-cm-ink divide-x-2 divide-cm-ink w-fit">
          <% [["10K+", "Joueurs"], ["50K+", "Échanges"], ["95%", "Satisfaits"]].each do |num, label| %>
            <div class="px-6 py-3">
              <div class="cm-display text-3xl"><%= num %></div>
              <div class="text-xs font-bold uppercase tracking-widest text-cm-text-muted"><%= label %></div>
            </div>
          <% end %>
        </div>
      </div>

      <%# Card "sticker" — tilted, hard shadow %>
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative">
          <div class="absolute -inset-3 bg-cm-accent border-2 border-cm-ink rotate-3"></div>
          <img src="https://cards.scryfall.io/large/front/b/a/bad6b494-d773-4f7d-ac39-85d82e1d3015.jpg?1559591839"
               alt="Black Lotus"
               class="relative w-[17rem] sm:w-[21rem] aspect-[63/88] object-cover border-2 border-cm-ink shadow-cm-hard -rotate-2 hover:rotate-0 transition-transform duration-300" />
          <span class="cm-tag absolute -bottom-3 -left-3 rotate-[-3deg]">⌖ près de vous</span>
        </div>
      </div>
    </div>
  </section>

  <%# ───────────── Features — broken numbered grid ───────────── %>
  <section class="border-y-2 border-cm-ink bg-cm-surface-2">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="cm-display text-4xl sm:text-5xl">Comment ça<br class="sm:hidden"> marche</h2>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        <% [
          ["01", "Importez", "Collez une liste ou un CSV (ManaBox, Moxfield…). 200 cartes en quelques secondes.", "bg-white"],
          ["02", "On matche", "L'algo croise vos cartes et vos recherches avec les joueurs autour de vous.", "bg-cm-accent text-white"],
          ["03", "Échangez", "Vous discutez, vous vous donnez rendez-vous, vous notez. Simple.", "bg-white"]
        ].each do |num, title, desc, klass| %>
          <div class="<%= klass %> border-2 border-cm-ink rounded-none p-7 shadow-cm-hard">
            <div class="cm-display text-5xl opacity-90"><%= num %></div>
            <h3 class="cm-display text-2xl mt-3"><%= title %></h3>
            <p class="mt-2 text-sm leading-relaxed <%= klass.include?('text-white') ? 'text-white/90' : 'text-cm-text-muted' %>"><%= desc %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ───────────── CTA — pop block ───────────── %>
  <section class="bg-cm-accent border-b-2 border-cm-ink">
    <div class="mx-auto max-w-7xl px-6 py-16 flex flex-col md:flex-row items-center justify-between gap-8">
      <h2 class="cm-display text-white text-5xl sm:text-6xl">Prêt à<br>échanger ?</h2>
      <div class="flex flex-col items-start gap-4">
        <p class="text-white/90 max-w-sm text-lg">Rejoignez la communauté française d'échange de cartes Magic.</p>
        <%= link_to "Créer un compte", new_user_registration_path, class: "cm-btn-ink text-base" %>
      </div>
    </div>
  </section>

  <%# ───────────── Trust strip ───────────── %>
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-cm-ink border-2 border-cm-ink">
      <% [["24/7", "Communauté"], ["100%", "Gratuit"], ["FR/EN", "Langues"], ["SSL", "Sécurisé"]].each do |num, label| %>
        <div class="bg-cm-bg px-6 py-6 text-center">
          <div class="cm-display text-3xl text-cm-accent"><%= num %></div>
          <div class="mt-1 text-xs font-bold uppercase tracking-widest text-cm-text-muted"><%= label %></div>
        </div>
      <% end %>
    </div>
  </section>
</div>
