<%# LANDING — identité "app fonctionnelle" (Geist + bleu électrique + scans). Sous le layout global. %>
<% scan = ->(name, version: "small") { "https://api.scryfall.com/cards/named?exact=#{CGI.escape(name)}&format=image&version=#{version}" } %>

<%# Hero %>
<section class="mx-auto max-w-7xl px-4 sm:px-6 pt-14 sm:pt-20 pb-14">
  <div class="grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <div class="ap-label">Échange de cartes · Magic: The Gathering</div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-[1.05] mt-3">
        Échangez vos cartes Magic, <span class="ap-accent">près de chez vous.</span>
      </h1>
      <p class="mt-5 max-w-md text-[1.0625rem] leading-relaxed ap-muted">
        Importez votre collection en quelques secondes. CardMonkey trouve les joueurs autour de vous
        qui veulent vos cartes — et celles que vous cherchez.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <%= link_to "Créer un compte — gratuit", new_user_registration_path, class: "ap-btn-accent" %>
        <%= link_to "Se connecter", new_user_session_path, class: "ap-btn-ghost" %>
      </div>
      <div class="mt-6 flex items-center gap-2">
        <span class="ap-chip ap-chip-accent">0 % commission</span>
        <span class="ap-chip">Import CSV</span>
        <span class="ap-chip">10 langues</span>
      </div>
    </div>

    <%# Aperçu cartes-produit %>
    <div class="grid grid-cols-3 gap-3">
      <% [["Black Lotus","Lyon"], ["Lightning Bolt","Paris"], ["Counterspell","Lyon"], ["Llanowar Elves","Lille"], ["Sol Ring","Nantes"], ["Demonic Tutor","Lyon"]].each do |name, place| %>
        <div class="ap-card ap-card-h overflow-hidden">
          <div class="ap-scan !rounded-none !border-0 border-b ap-divide"><img src="<%= scan.(name) %>" alt="<%= name %>" loading="lazy" class="w-full aspect-[63/88] object-cover"></div>
          <div class="p-2">
            <p class="text-[11px] font-semibold truncate"><%= name %></p>
            <p class="text-[10px] ap-faint">près de <%= place %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# Bande recherche / base %>
<section class="border-y ap-divide bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="ap-label">Une base complète</div>
        <h2 class="text-2xl font-bold tracking-tight mt-2">Toutes les cartes, tous les sets.</h2>
        <p class="mt-1 text-sm ap-muted">Recherchez, filtrez, ajoutez. Des milliers de versions à jour.</p>
      </div>
      <div class="ap-search w-full sm:w-80 flex items-center gap-2 ap-muted">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        Rechercher une carte…
      </div>
    </div>
    <div class="mt-6 grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-8 gap-3">
      <% ["Brainstorm","Swords to Plowshares","Dark Ritual","Lightning Bolt","Birds of Paradise","Sol Ring","Lightning Helix","Snapcaster Mage"].each do |c| %>
        <div class="ap-scan ap-card-h"><img src="<%= scan.(c) %>" alt="<%= c %>" loading="lazy" class="w-full aspect-[63/88] object-cover"></div>
      <% end %>
    </div>
  </div>
</section>

<%# Comment ça marche %>
<section class="mx-auto max-w-7xl px-4 sm:px-6 py-14">
  <div class="ap-label">Comment ça marche</div>
  <h2 class="text-2xl font-bold tracking-tight mt-2">Trois étapes, puis vous échangez.</h2>
  <div class="mt-7 grid md:grid-cols-3 gap-4">
    <% [
      ["Importez", "Collez une liste ou un CSV (ManaBox, Moxfield). Prêt en quelques secondes."],
      ["On vous matche", "L'algorithme croise vos cartes et vos recherches avec les joueurs proches."],
      ["Échangez", "Vous discutez, vous convenez d'un lieu, vous notez l'échange."]
    ].each_with_index do |(title, desc), i| %>
      <div class="ap-card p-5">
        <span class="ap-num inline-flex items-center justify-center w-9 h-9 rounded-lg text-white font-bold" style="background: var(--ap-accent);"><%= i + 1 %></span>
        <h3 class="font-bold mt-3"><%= title %></h3>
        <p class="mt-1.5 text-sm leading-relaxed ap-muted"><%= desc %></p>
      </div>
    <% end %>
  </div>
</section>

<%# CTA %>
<section class="mx-auto max-w-7xl px-4 sm:px-6 pb-16">
  <div class="rounded-2xl px-6 py-12 text-center text-white" style="background: linear-gradient(135deg, var(--ap-accent), var(--ap-accent-ink));">
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Prêt à faire tourner votre collection ?</h2>
    <p class="mt-2 text-white/85">Rejoignez la communauté française d'échange de cartes Magic.</p>
    <div class="mt-6 flex justify-center">
      <%= link_to "Créer un compte — gratuit", new_user_registration_path, class: "inline-flex items-center rounded-lg bg-white px-5 py-3 text-sm font-semibold", style: "color: var(--ap-accent-ink);" %>
    </div>
  </div>
</section>
