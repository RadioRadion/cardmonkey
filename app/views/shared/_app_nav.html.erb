<%# Chrome global "app fonctionnelle" (ap-*). Barre sombre + recherche + sous-nav. %>
<header class="text-white" style="background: var(--ap-header);">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 h-14 flex items-center gap-4">
    <%= link_to root_path, class: "flex items-center gap-2 shrink-0" do %>
      <span class="inline-flex items-center justify-center w-7 h-7 rounded text-white text-xs font-bold" style="background: var(--ap-accent);">C</span>
      <span class="font-bold tracking-tight hidden sm:block">CardMonkey</span>
    <% end %>

    <% if user_signed_in? %>
      <%= form_with url: user_user_cards_path(current_user), method: :get, class: "flex-1 max-w-2xl" do %>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[color:var(--ap-faint)]">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </span>
          <input type="text" name="q" placeholder="Rechercher une carte, un set, un joueur…" class="ap-search !pl-9">
        </div>
      <% end %>

      <div class="ml-auto flex items-center gap-2 sm:gap-3 shrink-0">
        <% unread = current_user.notifications.unread.count %>
        <%= link_to user_chatrooms_path(current_user), class: "hidden sm:inline-flex items-center justify-center w-9 h-9 rounded-md hover:bg-white/10 transition-colors", title: "Messages" do %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <% end %>
        <%= link_to user_path(current_user), class: "inline-flex items-center justify-center w-8 h-8 rounded-full text-white text-sm font-semibold", style: "background: var(--ap-accent);", title: "Profil" do %>
          <%= current_user.username.to_s.first&.upcase || "?" %>
        <% end %>
        <%= button_to destroy_user_session_path, method: :delete, class: "hidden sm:inline-flex text-sm text-white/70 hover:text-white transition-colors" do %>
          Déconnexion
        <% end %>
      </div>
    <% else %>
      <div class="ml-auto flex items-center gap-2 shrink-0">
        <%= link_to "Se connecter", new_user_session_path, class: "text-sm text-white/80 hover:text-white px-3 py-2 transition-colors" %>
        <%= link_to "Créer un compte", new_user_registration_path, class: "ap-btn-accent text-sm" %>
      </div>
    <% end %>
  </div>

  <% if user_signed_in? %>
    <div class="border-t border-white/10">
      <nav class="mx-auto max-w-7xl px-4 sm:px-6 flex items-center gap-1 text-sm overflow-x-auto">
        <% nav = [["Tableau de bord", root_path], ["Collection", user_user_cards_path(current_user)], ["Souhaits", user_user_wanted_cards_path(current_user)], ["Échanges", trades_path], ["Messages", user_chatrooms_path(current_user)]] %>
        <% nav.each do |label, path| %>
          <% active = current_page?(path) %>
          <%= link_to label, path, class: "px-3 py-2.5 whitespace-nowrap font-medium border-b-2 #{active ? 'text-white' : 'text-white/65 hover:text-white border-transparent'}", style: (active ? 'border-color: var(--ap-accent);' : '') %>
        <% end %>
      </nav>
    </div>
  <% end %>
</header>
