<% if notice %>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-4" data-controller="flash">
    <div class="flex items-center justify-between gap-4 rounded-lg px-4 py-2.5 text-sm" style="background: var(--ap-accent-tint); color: var(--ap-accent-ink); border:1px solid #cfe0ff;" role="alert">
      <span class="font-medium"><%= notice %></span>
      <button type="button" data-action="flash#close" class="shrink-0 opacity-70 hover:opacity-100">✕</button>
    </div>
  </div>
<% end %>
<% if alert %>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-4" data-controller="flash">
    <div class="flex items-center justify-between gap-4 rounded-lg px-4 py-2.5 text-sm" style="background: var(--ap-warn-tint); color: var(--ap-warn-ink); border:1px solid #f0dcb0;" role="alert">
      <span class="font-medium"><%= alert %></span>
      <button type="button" data-action="flash#close" class="shrink-0 opacity-70 hover:opacity-100">✕</button>
    </div>
  </div>
<% end %>
