<% if notice %>
  <div class="max-w-7xl mx-auto px-4 pt-4" data-controller="flash">
    <div class="bg-cm-accent text-white border-2 border-cm-ink px-4 py-3 flex items-center justify-between gap-4" role="alert">
      <span class="text-sm font-bold"><%= notice %></span>
      <button type="button" data-action="flash#close" class="shrink-0 hover:opacity-70"><i class="fas fa-times"></i></button>
    </div>
  </div>
<% end %>
<% if alert %>
  <div class="max-w-7xl mx-auto px-4 pt-4" data-controller="flash">
    <div class="bg-cm-warning text-cm-ink border-2 border-cm-ink px-4 py-3 flex items-center justify-between gap-4" role="alert">
      <span class="text-sm font-bold"><%= alert %></span>
      <button type="button" data-action="flash#close" class="shrink-0 hover:opacity-70"><i class="fas fa-times"></i></button>
    </div>
  </div>
<% end %>
