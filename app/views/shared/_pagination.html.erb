<% pagy_var = defined?(pagy) ? pagy : @pagy %>
<% if pagy_var && pagy_var.pages > 1 %>
  <nav class="flex items-center justify-between ap-card p-2.5 mt-6" aria-label="Pagination">
    <div class="flex-1 flex justify-start">
      <% if pagy_var.prev %>
        <%= link_to "← Précédent", pagy_url_for(pagy_var, pagy_var.prev), class: "inline-flex items-center px-3 py-1.5 text-sm ap-muted hover:text-[color:var(--ap-ink)] rounded-md transition-colors" %>
      <% end %>
    </div>

    <div class="hidden md:flex items-center gap-1">
      <% pagy_var.series.each do |item| %>
        <% case item %>
        <% when Integer %>
          <%= link_to item, pagy_url_for(pagy_var, item),
              class: "ap-num inline-flex items-center justify-center w-8 h-8 rounded-md text-sm transition-colors #{item == pagy_var.page ? 'text-white' : 'ap-muted hover:text-[color:var(--ap-ink)]'}",
              style: (item == pagy_var.page ? 'background: var(--ap-accent);' : '') %>
        <% when String %>
          <span class="ap-num inline-flex items-center justify-center w-8 h-8 text-sm ap-faint"><%= item %></span>
        <% end %>
      <% end %>
    </div>

    <div class="md:hidden text-sm ap-muted">Page <span class="ap-num"><%= pagy_var.page %></span> / <span class="ap-num"><%= pagy_var.pages %></span></div>

    <div class="flex-1 flex justify-end">
      <% if pagy_var.next %>
        <%= link_to "Suivant →", pagy_url_for(pagy_var, pagy_var.next), class: "inline-flex items-center px-3 py-1.5 text-sm ap-muted hover:text-[color:var(--ap-ink)] rounded-md transition-colors" %>
      <% end %>
    </div>
  </nav>
<% end %>
