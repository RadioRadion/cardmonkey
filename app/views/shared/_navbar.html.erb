<nav class="bg-cm-bg border-b-2 border-cm-ink sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-between items-center h-16">
      <!-- Logo et navigation gauche -->
      <div class="flex items-center space-x-8">
        <%= link_to root_path, class: "flex items-center gap-2 shrink-0 text-cm-ink" do %>
          <span class="inline-flex h-8 w-8 items-center justify-center bg-cm-accent border-2 border-cm-ink text-white text-lg">🐵</span>
          <span class="cm-display text-xl hidden sm:inline">CARDMONKEY</span>
        <% end %>

        <div class="hidden lg:flex items-center space-x-1">
          <% if user_signed_in? %>
            <%= link_to t('navbar.home'), root_path, class: "px-3 py-2 text-sm font-bold uppercase tracking-wide text-cm-ink hover:text-cm-accent transition-colors" %>
            <%= link_to t('navbar.collection'), user_user_cards_path(current_user), class: "px-3 py-2 text-sm font-bold uppercase tracking-wide text-cm-ink hover:text-cm-accent transition-colors" %>
            <%= link_to t('navbar.wantlist'), user_user_wanted_cards_path(current_user), class: "px-3 py-2 text-sm font-bold uppercase tracking-wide text-cm-ink hover:text-cm-accent transition-colors" %>
            <%= link_to t('navbar.trades'), trades_path, class: "px-3 py-2 text-sm font-bold uppercase tracking-wide text-cm-ink hover:text-cm-accent transition-colors" %>
            <%= link_to t('navbar.messages'), messages_path, class: "px-3 py-2 text-sm font-bold uppercase tracking-wide text-cm-ink hover:text-cm-accent transition-colors" %>
          <% end %>
        </div>
      </div>

      <!-- Menu droite -->
      <div class="flex items-center space-x-3">
        <% if user_signed_in? %>
          <!-- Notifications -->
          <div class="relative" data-controller="notifications" data-notifications-has-menu-value="true">
            <button type="button" class="relative p-2 rounded-lg text-cm-text-muted hover:text-cm-text hover:bg-cm-surface-2 transition-colors"
                    data-action="click->notifications#toggle">
              <i class="fas fa-bell text-lg"></i>
              <span id="notifications_count">
                <% if current_user.notifications.unread.any? %>
                  <span class="absolute top-0 right-0 inline-flex items-center justify-center h-4 min-w-4 px-1 text-[10px] font-bold leading-none text-white bg-cm-danger rounded-full">
                    <%= current_user.notifications.unread.count %>
                  </span>
                <% end %>
              </span>
            </button>

            <div data-notifications-target="menu"
                 class="hidden absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-xl ring-1 ring-black/5 z-50 overflow-hidden">
              <div class="px-4 py-2 border-b">
                <h3 class="text-sm font-medium text-gray-900"><%= t('.notifications') %></h3>
              </div>
              <%= turbo_frame_tag "notifications" do %>
                <%= render "notifications/notifications", notifications: current_user.notifications.recent %>
              <% end %>
            </div>
          </div>

          <!-- Profil -->
          <div class="relative" data-controller="dropdown">
            <button type="button" class="flex rounded-full ring-1 ring-cm-border p-0.5 hover:ring-cm-accent transition" data-action="click->dropdown#toggle">
              <div id="navbar_avatar">
                <%= render "shared/navbar_avatar", user: current_user %>
              </div>
            </button>

            <div data-dropdown-target="menu"
                 class="hidden absolute right-0 mt-2 w-52 bg-white rounded-lg shadow-xl ring-1 ring-black/5 z-50 overflow-hidden">
              <div class="px-4 py-3 border-b">
                <p class="text-sm font-medium text-gray-900"><%= current_user.username %></p>
                <p class="text-xs text-gray-500 truncate"><%= current_user.email %></p>
              </div>
              <%= link_to t('navbar.profile.my_profile'), user_path(current_user), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
              <%= link_to t('navbar.profile.edit_profile'), edit_user_path(current_user), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
              <%= link_to t('navbar.profile.dashboard'), matches_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
              <%= link_to "Aide / FAQ", faq_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
              <%= button_to t('navbar.profile.sign_out'), destroy_user_session_path, method: :delete,
                    class: "block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50" %>
            </div>
          </div>
        <% else %>
          <%= link_to t('navbar.auth.sign_in'), new_user_session_path, class: "text-sm text-cm-text-muted hover:text-cm-text transition-colors" %>
          <%= link_to t('navbar.auth.sign_up'), new_user_registration_path, class: "cm-btn-primary" %>
        <% end %>

        <!-- Menu mobile -->
        <button type="button" class="lg:hidden p-2 rounded-lg text-cm-text-muted hover:text-cm-text hover:bg-cm-surface-2"
                data-controller="mobile-menu" data-action="mobile-menu#toggle">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Menu mobile déroulant -->
    <div class="hidden lg:hidden pb-3" data-mobile-menu-target="menu">
      <div class="space-y-1">
        <% if user_signed_in? %>
          <%= link_to t('navbar.home'), root_path, class: "block px-3 py-2 rounded-lg text-base text-cm-text-muted hover:text-cm-text hover:bg-cm-surface-2" %>
          <%= link_to t('navbar.collection'), user_user_cards_path(current_user), class: "block px-3 py-2 rounded-lg text-base text-cm-text-muted hover:text-cm-text hover:bg-cm-surface-2" %>
          <%= link_to t('navbar.wantlist'), user_user_wanted_cards_path(current_user), class: "block px-3 py-2 rounded-lg text-base text-cm-text-muted hover:text-cm-text hover:bg-cm-surface-2" %>
          <%= link_to t('navbar.trades'), trades_path, class: "block px-3 py-2 rounded-lg text-base text-cm-text-muted hover:text-cm-text hover:bg-cm-surface-2" %>
          <%= link_to t('navbar.messages'), messages_path, class: "block px-3 py-2 rounded-lg text-base text-cm-text-muted hover:text-cm-text hover:bg-cm-surface-2" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
