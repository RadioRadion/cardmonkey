<div class="mx-auto max-w-7xl px-4 sm:px-6 py-6" data-controller="wanted-cards">
  <%# Header %>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Liste de souhaits</h1>
      <p class="text-sm ap-muted mt-0.5">Les cartes que vous recherchez.</p>
    </div>
    <%= link_to "Ajouter une carte", new_user_user_wanted_card_path(@user), class: "ap-btn-accent" %>
  </div>

  <%# Filtres %>
  <div class="mt-5 flex flex-col md:flex-row gap-2">
    <div class="relative flex-1">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 ap-faint">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </span>
      <input type="text" placeholder="Rechercher une carte…" class="ap-search !pl-9" data-action="input->wanted-cards#search">
    </div>
    <div class="flex gap-2 flex-wrap">
      <select class="rounded-md border bg-white text-sm px-3 py-2" style="border-color: var(--ap-line);" data-action="change->wanted-cards#filterByLanguage">
        <option value="">Toutes les langues</option>
        <% @user_wanted_cards.pluck(:language).uniq.compact.each do |lang| %>
          <option value="<%= lang %>"><%= language_label(lang) %></option>
        <% end %>
      </select>
      <select class="rounded-md border bg-white text-sm px-3 py-2" style="border-color: var(--ap-line);" data-action="change->wanted-cards#filterByMinCondition">
        <option value="">Tous états</option>
        <% %w[mint near_mint excellent good light_played played poor].each do |c| %>
          <option value="<%= c %>"><%= c.humanize %></option>
        <% end %>
      </select>
      <button class="ap-btn-ghost" data-action="click->wanted-cards#toggleFoilFilter">Foil</button>
      <button class="ap-btn-ghost" data-action="click->wanted-cards#toggleMatchesFilter">Avec matchs</button>
    </div>
  </div>

  <%# Grille %>
  <div class="mt-5 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3">
    <% @user_wanted_cards.each do |user_wanted_card| %>
      <div class="group ap-card overflow-hidden"
           data-wanted-cards-target="card"
           data-card-name-en="<%= user_wanted_card.card.name_en %>"
           data-card-name-fr="<%= user_wanted_card.card.name_fr %>"
           data-language="<%= user_wanted_card.language %>"
           data-min-condition="<%= user_wanted_card.min_condition %>"
           data-foil="<%= user_wanted_card.foil %>"
           data-matches-count="<%= user_wanted_card.matches.count %>">
        <div class="relative ap-scan !rounded-none !border-0 border-b ap-divide">
          <% if user_wanted_card.img_uri.present? %>
            <%= image_tag user_wanted_card.img_uri, alt: user_wanted_card.card.name_en, loading: "lazy", class: "w-full aspect-[63/88] object-cover" %>
          <% else %>
            <div class="w-full aspect-[63/88] flex items-center justify-center text-xs ap-faint text-center p-2"><%= user_wanted_card.card.name_en %></div>
          <% end %>
          <% if user_wanted_card.foil %><span class="absolute top-1.5 left-1.5 ap-chip ap-chip-accent !text-[9px] !px-1.5">FOIL</span><% end %>
          <% if user_wanted_card.matches.any? %>
            <span class="absolute top-1.5 right-1.5 ap-chip ap-chip-accent ap-num !text-[9px] !px-1.5"><%= user_wanted_card.matches.count %> match<%= 's' if user_wanted_card.matches.count > 1 %></span>
          <% end %>
        </div>
        <div class="p-2.5">
          <h3 class="text-xs font-semibold truncate" title="<%= user_wanted_card.card.name_en %>"><%= user_wanted_card.card.name_en %></h3>
          <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
            <span class="inline-block w-2.5 h-2.5 rounded-full <%= rarity_color(user_wanted_card.card_version&.rarity) %>"></span>
            <span class="ap-chip !text-[9px] !px-1.5 uppercase"><%= user_wanted_card.language == 'any' ? 'Toutes' : language_label(user_wanted_card.language) %></span>
            <% if user_wanted_card.min_condition %><span class="ap-chip !text-[9px] !px-1.5">≥ <%= user_wanted_card.min_condition.humanize %></span><% end %>
          </div>
          <div class="mt-2 flex items-center justify-between">
            <span class="ap-num text-sm font-bold ap-link">
              <% price = user_wanted_card.foil ? user_wanted_card.card_version&.eur_foil_price : user_wanted_card.card_version&.eur_price %>
              <%= number_to_currency(price, unit: "€", format: "%n %u") %>
            </span>
            <div class="flex items-center gap-0.5">
              <%= link_to edit_user_user_wanted_card_path(user_wanted_card.user, user_wanted_card), class: "p-1.5 ap-muted hover:text-[color:var(--ap-ink)]", title: t('wants.table.actions.edit') do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
              <% end %>
              <button data-action="wanted-cards#delete" class="p-1.5 ap-muted hover:text-red-600" title="<%= t('wants.table.actions.delete') %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @pagy && @pagy.pages > 1 %>
    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
</div>
