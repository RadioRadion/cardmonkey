<div class="cm-theme min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" data-controller="cards">
    <%# Header %>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
      <div>
        <span class="cm-kicker text-cm-accent">Votre collection</span>
        <h1 class="cm-display text-4xl sm:text-5xl mt-1">Ma collection</h1>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to import_user_user_cards_path(@user), class: "cm-btn-primary" do %>
          <i class="fas fa-file-import"></i> Importer en masse
        <% end %>
        <%= link_to new_user_user_card_path(@user), class: "cm-btn-ink" do %>
          <i class="fas fa-plus"></i> Ajouter
        <% end %>
      </div>
    </div>

    <%# Stats %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-cm-ink border-2 border-cm-ink mb-6">
      <% total_value = @user_cards.reduce(0) do |sum, uc|
           price = (uc.foil ? uc.card_version&.eur_foil_price : uc.card_version&.eur_price) || 0
           sum + (price * uc.quantity)
         end %>
      <% [
           [(@user_cards.sum(&:quantity) rescue 0), "Cartes"],
           [(@user_cards.count rescue 0), "Uniques"],
           [number_to_currency(total_value, unit: "€", format: "%n %u"), "Valeur"],
           [@user_cards.pluck(:language).uniq.compact.count, "Langues"]
         ].each do |num, label| %>
        <div class="bg-cm-bg px-5 py-4">
          <div class="cm-display text-2xl sm:text-3xl"><%= num %></div>
          <div class="text-[11px] font-bold uppercase tracking-widest text-cm-text-muted"><%= label %></div>
        </div>
      <% end %>
    </div>

    <%# Filtres %>
    <div class="cm-card-flat p-4 mb-6">
      <div class="flex flex-col md:flex-row gap-3">
        <input type="text" placeholder="Rechercher une carte…" class="cm-input flex-1" data-action="input->cards#search">
        <div class="flex gap-2 flex-wrap">
          <select class="cm-input" data-action="change->cards#filterByLanguage">
            <option value="">Toutes les langues</option>
            <% @user_cards.pluck(:language).uniq.compact.each do |lang| %>
              <option value="<%= lang %>"><%= language_label(lang) %></option>
            <% end %>
          </select>
          <select class="cm-input" data-action="change->cards#filterByCondition">
            <option value="">Tous états</option>
            <% %w[mint near_mint excellent good light_played played poor].each do |c| %>
              <option value="<%= c %>"><%= c.humanize %></option>
            <% end %>
          </select>
          <button class="cm-btn-ghost" data-action="click->cards#toggleFoilFilter">
            <i class="fas fa-star text-cm-accent"></i> Foil
          </button>
        </div>
      </div>
    </div>

    <%# Grille %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-4">
      <% @user_cards.each do |user_card| %>
        <div class="group cm-card overflow-hidden"
             data-cards-target="card"
             data-card-name-en="<%= user_card.card_version.card.name_en %>"
             data-card-name-fr="<%= user_card.card_version.card.name_fr %>"
             data-language="<%= user_card.language %>"
             data-condition="<%= user_card.condition %>"
             data-foil="<%= user_card.foil %>">
          <div class="relative aspect-[63/88] overflow-hidden bg-cm-surface-2 border-b-2 border-cm-ink">
            <% if user_card.card_version.img_uri.present? %>
              <%= image_tag user_card.card_version.img_uri, alt: user_card.card_version.card.name_en,
                    class: "w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center text-cm-text-subtle text-xs text-center p-2"><%= user_card.card_version.card.name_en %></div>
            <% end %>
            <div class="absolute top-2 right-2 cm-tag-pop"><%= user_card.quantity %>×</div>
            <% if user_card.foil %>
              <div class="absolute top-2 left-2 cm-tag">FOIL</div>
            <% end %>
          </div>

          <div class="p-3">
            <h3 class="font-bold truncate text-sm" title="<%= user_card.card_version.card.name_en %>"><%= user_card.card_version.card.name_en %></h3>
            <div class="mt-2 flex flex-wrap items-center gap-1.5 text-[11px]">
              <span class="inline-block w-3 h-3 rounded-full <%= rarity_color(user_card.card_version.rarity) %>" title="<%= rarity_label(user_card.card_version.rarity) %>"></span>
              <span class="px-1.5 py-0.5 bg-cm-surface-2 text-cm-text-muted font-bold uppercase tracking-wide"><%= language_label(user_card.language) %></span>
              <span class="px-1.5 py-0.5 bg-cm-surface-2 text-cm-text-muted font-bold uppercase tracking-wide"><%= user_card.condition&.humanize %></span>
            </div>
            <div class="mt-3 flex items-center justify-between">
              <span class="cm-display text-lg">
                <% price = user_card.foil ? user_card.card_version.eur_foil_price : user_card.card_version.eur_price %>
                <%= number_to_currency(price, unit: "€", format: "%n %u") %>
              </span>
              <div class="flex items-center gap-1">
                <%= link_to edit_user_user_card_path(user_card.user, user_card), class: "p-2 text-cm-ink hover:text-cm-accent transition-colors", title: t('cards.table.actions.edit') do %>
                  <i class="fas fa-pen text-sm"></i>
                <% end %>
                <button data-action="card-preview#delete" class="p-2 text-cm-danger hover:opacity-70 transition" title="<%= t('cards.table.actions.delete') %>">
                  <i class="fas fa-trash text-sm"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @pagy && @pagy.pages > 1 %>
      <%= render "shared/pagination", pagy: @pagy %>
    <% end %>
  </div>
</div>
