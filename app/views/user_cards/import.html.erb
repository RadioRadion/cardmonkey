<div class="py-8">
  <div class="w-full max-w-3xl mx-auto px-4 sm:px-6">
    <div class="mb-6">
      <div class="ap-label">Collection</div>
      <h1 class="text-2xl font-bold tracking-tight mt-1">Importer ma collection</h1>
      <p class="mt-1 text-sm ap-muted">Ajoutez des centaines de cartes en quelques secondes.</p>
    </div>

    <%= form_with url: import_run_user_user_cards_path(@user), method: :post,
                  data: { controller: "collection-import" },
                  html: { multipart: true } do |f| %>
      <%= hidden_field_tag :source, "decklist", data: { "collection-import-target": "source" } %>

      <div class="ap-card p-6">
        <%# Tabs %>
        <div class="inline-flex rounded-lg p-1 mb-6" style="background: var(--ap-bg);">
          <button type="button" data-source="decklist" data-action="collection-import#select" data-collection-import-target="tab"
                  class="px-4 py-2 text-sm font-semibold rounded-md transition">Coller une liste</button>
          <button type="button" data-source="csv" data-action="collection-import#select" data-collection-import-target="tab"
                  class="px-4 py-2 text-sm font-semibold rounded-md transition">Fichier CSV</button>
        </div>

        <%# Panel: liste %>
        <div data-source="decklist" data-collection-import-target="panel">
          <label class="block text-sm font-semibold mb-1.5">Votre liste de cartes</label>
          <%= text_area_tag :decklist, nil, rows: 10,
                placeholder: "4 Sol Ring (CMR) 472\n1 Black Lotus\n2 Arcane Signet *F*\nLightning Bolt",
                class: "ap-search ap-mono !text-sm" %>
          <p class="mt-2 text-xs ap-muted">
            Une carte par ligne : <code class="ap-mono">quantité nom (ÉDITION) numéro</code>. L'édition et le numéro sont optionnels. Ajoutez <code class="ap-mono">*F*</code> pour un foil.
          </p>
        </div>

        <%# Panel: CSV %>
        <div data-source="csv" data-collection-import-target="panel" class="hidden">
          <label class="block text-sm font-semibold mb-1.5">Fichier CSV</label>
          <%= file_field_tag :file, accept: ".csv,text/csv",
                class: "block w-full text-sm ap-muted file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-[#15181c] file:text-white file:cursor-pointer file:font-semibold" %>
          <div class="mt-3 rounded-lg p-3 text-xs" style="background: var(--ap-accent-tint); color: var(--ap-accent-ink);">
            <p class="font-semibold mb-1">Astuce : scannez votre collection</p>
            <p>Scannez vos cartes avec <strong>ManaBox</strong>, <strong>Moxfield</strong> ou <strong>Deckbox</strong>, exportez en CSV et déposez le fichier ici. Les colonnes <em>Name, Edition, Condition, Language, Foil, Count</em> (ou un <em>Scryfall ID</em>) sont reconnues.</p>
          </div>
        </div>

        <%# Defaults %>
        <div class="mt-6 border-t ap-divide pt-5">
          <p class="text-sm font-semibold mb-3">Valeurs par défaut <span class="ap-faint font-normal">(si l'info manque dans la liste/fichier)</span></p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs ap-muted mb-1">État</label>
              <%= select_tag :default_condition, options_for_select(UserCard.conditions.keys.map { |c| [c.humanize, c] }, "near_mint"), class: "w-full rounded-md border bg-white text-sm px-3 py-2", style: "border-color: var(--ap-line);" %>
            </div>
            <div>
              <label class="block text-xs ap-muted mb-1">Langue</label>
              <%= select_tag :default_language, options_for_select(UserCard.languages.values.map { |l| [l.upcase, l] }, "en"), class: "w-full rounded-md border bg-white text-sm px-3 py-2", style: "border-color: var(--ap-line);" %>
            </div>
            <div class="flex items-end">
              <label class="inline-flex items-center gap-2 text-sm">
                <%= check_box_tag :default_foil, "foil", false, class: "rounded" %>
                Foil par défaut
              </label>
            </div>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-between">
          <%= link_to "Annuler", user_user_cards_path(@user), class: "text-sm ap-muted hover:text-[color:var(--ap-ink)]" %>
          <%= f.submit "Importer", class: "ap-btn-accent cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
