<div class="py-8">
  <div class="w-full max-w-3xl mx-auto px-4 sm:px-6">
    <div class="mb-6">
      <div class="ap-label">Collection</div>
      <h1 class="text-2xl font-bold tracking-tight mt-1">Import terminé</h1>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
      <div class="ap-card p-5 text-center">
        <p class="ap-num text-3xl font-bold" style="color: var(--ap-accent-ink);"><%= @result.imported %></p>
        <p class="text-sm ap-muted mt-1">ajoutée(s)</p>
      </div>
      <div class="ap-card p-5 text-center">
        <p class="ap-num text-3xl font-bold"><%= @result.updated %></p>
        <p class="text-sm ap-muted mt-1">quantité mise à jour</p>
      </div>
      <div class="ap-card p-5 text-center">
        <p class="ap-num text-3xl font-bold <%= @result.skipped_count.positive? ? '' : 'ap-faint' %>" style="<%= 'color: var(--ap-warn-ink);' if @result.skipped_count.positive? %>"><%= @result.skipped_count %></p>
        <p class="text-sm ap-muted mt-1">ignorée(s)</p>
      </div>
    </div>

    <% if @result.skipped.any? %>
      <div class="ap-card overflow-hidden mb-6">
        <div class="px-5 py-3 border-b ap-divide" style="background: var(--ap-warn-tint);">
          <h2 class="text-sm font-semibold" style="color: var(--ap-warn-ink);">Lignes non importées</h2>
          <p class="text-xs" style="color: var(--ap-warn-ink);">Vérifie l'orthographe du nom ou précise l'édition.</p>
        </div>
        <ul class="divide-y ap-divide max-h-80 overflow-y-auto">
          <% @result.skipped.each do |s| %>
            <li class="px-5 py-2 text-sm flex justify-between gap-4">
              <span class="truncate"><%= s[:label] %></span>
              <span class="ap-faint whitespace-nowrap"><%= s[:reason] %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="flex items-center justify-center gap-4">
      <%= link_to "Voir ma collection", user_user_cards_path(@user), class: "ap-btn-accent" %>
      <%= link_to "Importer encore", import_user_user_cards_path(@user), class: "text-sm ap-muted hover:text-[color:var(--ap-ink)]" %>
    </div>
  </div>
</div>
