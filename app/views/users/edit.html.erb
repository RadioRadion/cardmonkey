<%# app/views/users/edit.html.erb %>
<div class="py-8 px-4">
  <div class="max-w-3xl mx-auto">
    <div class="ap-card overflow-hidden">
      <div class="text-white px-6 py-7" style="background: var(--ap-ink);">
        <div class="flex items-center space-x-4">
          <%= turbo_frame_tag "profile_avatar" do %>
            <%= render "users/avatar", user: @user %>
          <% end %>
          <%= turbo_frame_tag "profile_info" do %>
            <%= render "users/profile_info", user: @user, editing: @editing %>
          <% end %>
        </div>
      </div>

      <%= turbo_frame_tag "trading_preferences" do %>
        <%= render "users/trading_preferences", user: @user, editing_preferences: @editing_preferences %>
      <% end %>

      <div class="p-6">
        <h2 class="ap-label mb-4"><%= t('users.profile.trading_statistics') %></h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <% [
               [@stats[:total_matches], t('users.profile.total_matches')],
               [@stats[:unique_matched_users], t('users.profile.trading_partners')],
               [@user.user_cards.count, t('users.profile.cards_listed')],
               [@user.user_wanted_cards.count, t('users.profile.cards_wanted')]
             ].each do |num, label| %>
            <div class="ap-card p-4 text-center" style="background: var(--ap-bg);">
              <div class="ap-num text-2xl font-bold ap-accent"><%= num %></div>
              <div class="ap-label !text-[10px] mt-1"><%= label %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
