<%# app/views/users/edit.html.erb %>
<div class="cm-theme min-h-screen px-4 py-8">
  <div class="max-w-3xl mx-auto">
    <div class="cm-card-flat overflow-hidden">
      <!-- Profile Header -->
      <div class="bg-cm-ink text-cm-bg px-6 py-8">
        <div class="flex items-center space-x-4">
          <%= turbo_frame_tag "profile_avatar" do %>
            <%= render "users/avatar", user: @user %>
          <% end %>
          
          <%= turbo_frame_tag "profile_info" do %>
            <%= render "users/profile_info", user: @user, editing: @editing %>
          <% end %>
        </div>
      </div>

      <%= turbo_frame_tag "trading_preferences" do %>
        <%= render "users/trading_preferences", user: @user, editing_preferences: @editing_preferences %>
      <% end %>

      <!-- Trading Statistics -->
      <div class="p-6">
        <h2 class="cm-display text-xl mb-4"><%= t('users.profile.trading_statistics') %></h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-cm-surface-2 border-2 border-cm-ink p-4 text-center">
            <div class="cm-display text-2xl text-cm-accent"><%= @stats[:total_matches] %></div>
            <div class="text-xs font-bold uppercase tracking-widest text-cm-text-muted"><%= t('users.profile.total_matches') %></div>
          </div>
          <div class="bg-cm-surface-2 border-2 border-cm-ink p-4 text-center">
            <div class="cm-display text-2xl text-cm-accent"><%= @stats[:unique_matched_users] %></div>
            <div class="text-xs font-bold uppercase tracking-widest text-cm-text-muted"><%= t('users.profile.trading_partners') %></div>
          </div>
          <div class="bg-cm-surface-2 border-2 border-cm-ink p-4 text-center">
            <div class="cm-display text-2xl text-cm-accent"><%= @user.user_cards.count %></div>
            <div class="text-xs font-bold uppercase tracking-widest text-cm-text-muted"><%= t('users.profile.cards_listed') %></div>
          </div>
          <div class="bg-cm-surface-2 border-2 border-cm-ink p-4 text-center">
            <div class="cm-display text-2xl text-cm-accent"><%= @user.user_wanted_cards.count %></div>
            <div class="text-xs font-bold uppercase tracking-widest text-cm-text-muted"><%= t('users.profile.cards_wanted') %></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>