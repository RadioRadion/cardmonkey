<div class="cm-theme min-h-screen">
  <div class="container mx-auto px-4 py-6">
    <div class="grid grid-cols-12 gap-6">
      <!-- Sidebar conversations -->
      <div class="hidden md:block md:col-span-4 lg:col-span-3 cm-card-flat overflow-hidden">
        <div class="px-4 py-3 border-b-2 border-cm-ink">
          <h2 class="cm-display text-lg">Conversations</h2>
        </div>
        <div class="overflow-y-auto max-h-[calc(100vh-220px)] divide-y-2 divide-cm-border/20">
          <% @chatrooms.each do |chatroom| %>
            <% other_user = chatroom.other_user(current_user) %>
            <%= link_to user_chatroom_path(current_user, chatroom),
                  class: "block p-3 hover:bg-cm-surface-2 transition-colors #{@chatroom == chatroom ? 'bg-cm-surface-2' : ''}" do %>
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 flex items-center justify-center bg-cm-ink text-cm-bg font-bold border-2 border-cm-ink">
                  <%= other_user&.username&.first&.upcase || '?' %>
                </span>
                <div class="min-w-0">
                  <h3 class="font-bold truncate"><%= other_user&.username || 'Inconnu' %></h3>
                  <% last_message = @last_messages[chatroom.id] %>
                  <% if last_message %>
                    <p class="text-xs text-cm-text-muted truncate"><%= last_message.display_content %></p>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Chat -->
      <div class="col-span-12 md:col-span-8 lg:col-span-9 cm-card-flat flex flex-col h-[calc(100vh-140px)]" data-controller="chat">
        <div class="px-4 py-3 border-b-2 border-cm-ink flex items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <span class="w-9 h-9 flex items-center justify-center bg-cm-ink text-cm-bg font-bold border-2 border-cm-ink">
              <%= @other_user&.username&.first&.upcase || '?' %>
            </span>
            <div class="min-w-0">
              <h2 class="cm-display text-lg truncate"><%= @other_user&.username || 'Inconnu' %></h2>
              <span class="text-xs text-cm-text-subtle" data-user-status="<%= @other_user&.id %>">offline</span>
            </div>
          </div>

          <% if @active_trade %>
            <%= link_to trade_path(@active_trade), data: { turbo: false }, class: "cm-btn-ghost text-xs whitespace-nowrap" do %>
              <i class="fas fa-exchange-alt"></i> Échange (<%= trade_status_text(@active_trade.status) %>)
            <% end %>
          <% end %>
        </div>

        <%= turbo_stream_from @chatroom %>
        <div id="messages" class="flex-1 overflow-y-auto p-4 bg-cm-bg" data-chat-target="messages" data-chatroom-id="<%= @chatroom.id %>">
          <div id="message-list" data-chat-target="messageList" class="space-y-3">
            <%= render @messages %>
          </div>
        </div>

        <div id="typing-indicator" class="px-4 py-2 text-sm text-cm-text-muted hidden"></div>

        <div class="border-t-2 border-cm-ink p-3">
          <%= turbo_frame_tag "message_form" do %>
            <%= render "messages/form", message: Message.new, chatroom: @chatroom %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
