<div class="mx-auto max-w-7xl px-4 sm:px-6 py-5">
  <div class="grid grid-cols-12 gap-5">
    <!-- Sidebar conversations -->
    <div class="hidden md:block md:col-span-4 lg:col-span-3 ap-card overflow-hidden">
      <div class="px-4 py-3 border-b ap-divide"><h2 class="ap-label">Conversations</h2></div>
      <div class="overflow-y-auto max-h-[calc(100vh-220px)] divide-y ap-divide">
        <% @chatrooms.each do |chatroom| %>
          <% other_user = chatroom.other_user(current_user) %>
          <%= link_to user_chatroom_path(current_user, chatroom),
                class: "block p-3 ap-row transition-colors #{@chatroom == chatroom ? 'bg-[color:var(--ap-accent-tint)]' : ''}" do %>
            <div class="flex items-center gap-3">
              <span class="w-9 h-9 flex items-center justify-center rounded-full text-white font-semibold text-sm" style="background: var(--ap-ink);"><%= other_user&.username&.first&.upcase || '?' %></span>
              <div class="min-w-0">
                <h3 class="font-semibold text-sm truncate"><%= other_user&.username || 'Inconnu' %></h3>
                <% last_message = @last_messages[chatroom.id] %>
                <% if last_message %><p class="text-xs ap-muted truncate"><%= last_message.display_content %></p><% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Chat -->
    <div class="col-span-12 md:col-span-8 lg:col-span-9 ap-card flex flex-col h-[calc(100vh-140px)]" data-controller="chat">
      <div class="px-4 py-3 border-b ap-divide flex items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <span class="w-9 h-9 flex items-center justify-center rounded-full text-white font-semibold text-sm" style="background: var(--ap-ink);"><%= @other_user&.username&.first&.upcase || '?' %></span>
          <div class="min-w-0">
            <h2 class="font-bold truncate"><%= @other_user&.username || 'Inconnu' %></h2>
            <span class="text-xs ap-faint" data-user-status="<%= @other_user&.id %>">offline</span>
          </div>
        </div>
        <% if @active_trade %>
          <%= link_to trade_path(@active_trade), data: { turbo: false }, class: "ap-btn-ghost text-xs whitespace-nowrap" do %>
            Échange (<%= trade_status_text(@active_trade.status) %>)
          <% end %>
        <% end %>
      </div>

      <%= turbo_stream_from @chatroom %>
      <div id="messages" class="flex-1 overflow-y-auto p-4" style="background: var(--ap-bg);" data-chat-target="messages" data-chatroom-id="<%= @chatroom.id %>">
        <div id="message-list" data-chat-target="messageList" class="space-y-3">
          <%= render @messages %>
        </div>
      </div>

      <div id="typing-indicator" class="px-4 py-2 text-sm ap-muted hidden"></div>

      <div class="border-t ap-divide p-3 bg-white">
        <%= turbo_frame_tag "message_form" do %>
          <%= render "messages/form", message: Message.new, chatroom: @chatroom %>
        <% end %>
      </div>
    </div>
  </div>
</div>
